# Copy to .env and adjust as needed. .env is gitignored — never commit real secrets.

# --- Postgres (docker-compose) ---
POSTGRES_USER=traintrack
POSTGRES_PASSWORD=traintrack
POSTGRES_DB=traintrack_core
POSTGRES_PORT=5432

# --- Kafka (docker-compose) ---
KAFKA_PORT=29092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- LocalStack / S3 (docker-compose) ---
LOCALSTACK_PORT=4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET_NAME=traintrack-certificates
# LocalStack only — unset this in real environments so the SDK uses AWS's
# own regional endpoints instead of overriding to a local URL.
AWS_S3_ENDPOINT=http://localhost:4566
S3_PRESIGNED_URL_TTL_MINUTES=15

# --- core-api application ---
JWT_SECRET=change-me-to-a-long-random-value-in-real-environments
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# --- Phase 8: AI assistant ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=1024
# Per-user request cap enforced in Postgres (see assistant_rate_limits) —
# real money per Anthropic API call, so this is a hard ceiling, not a nicety.
ASSISTANT_RATE_LIMIT_MAX_REQUESTS=20
ASSISTANT_RATE_LIMIT_WINDOW_MINUTES=60
