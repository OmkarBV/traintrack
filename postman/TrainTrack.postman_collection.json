        {
          "name": "audit-service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{auditServiceUrl}}/actuator/health",
              "host": ["{{auditServiceUrl}}"],
              "path": ["actuator", "health"]
